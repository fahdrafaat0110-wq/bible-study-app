# ============================================================
# دراسة الكتاب الصحيح - Environment Configuration
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# SQLite (default, zero-infra, relational):
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# --- Next.js ---
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client) ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- SECURITY: ADMIN WHITELIST (CRITICAL) ---
# Comma-separated list of the ONLY Google accounts allowed to log in.
# This is the single enforcement point: no public registration,
# no other Google accounts can enter the dashboard.
ADMIN_EMAILS="admin@example.com"

# --- SESSION ---
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-char-random-secret"

# --- OPTIONAL: Rate limiting / backup ---
# ADMIN_API_KEY="optional-shared-secret-for-remote-backup-endpoint"